{
  "schema": "fcb.design-plan/1",
  "spec_id": "g3-dev-014-extrusion-end-cap",
  "spec_text": "An end cap for 20 mm by 20 mm aluminium extrusion: a 20 mm square plate 5 mm thick with a single 5.5 mm through hole at the centre.",
  "steps": [
    {
      "tool": "feature_body_create",
      "args": {
        "name": "Body"
      },
      "intent": "every PartDesign feature builds into a Body"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Outline",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Outline"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Outline",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              -10.0,
              -10.0
            ],
            "end": [
              10.0,
              -10.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              10.0,
              -10.0
            ],
            "end": [
              10.0,
              10.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              10.0,
              10.0
            ],
            "end": [
              -10.0,
              10.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              -10.0,
              10.0
            ],
            "end": [
              -10.0,
              -10.0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -10.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -10.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 20.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 20.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "20 x 20 outline"
    },
    {
      "tool": "feature_pad",
      "args": {
        "body": "Body",
        "profile": "Outline",
        "name": "Plate",
        "length": {
          "value": 5.0,
          "unit": "mm"
        }
      },
      "intent": "extrude Outline 5 mm"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Holes",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Holes"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Holes",
        "geometry": [
          {
            "kind": "circle",
            "center": [
              0,
              0
            ],
            "radius": {
              "value": 2.75,
              "unit": "mm"
            }
          }
        ],
        "constraints": [
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "Diameter",
            "first": 0,
            "value": {
              "value": 5.5,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "1 hole centres"
    },
    {
      "tool": "feature_hole",
      "args": {
        "body": "Body",
        "profile": "Holes",
        "name": "Drill",
        "diameter": {
          "value": 5.5,
          "unit": "mm"
        },
        "depth_type": "ThroughAll",
        "reversed": true
      },
      "intent": "drill 5.5 mm through"
    }
  ],
  "approved": true,
  "approved_by": "designer-actor",
  "rationale": "20 mm square, 5 mm thick, one 5.5 mm hole on the centre, drilled through."
}
