{
  "schema": "fcb.design-plan/1",
  "spec_id": "g3-dev-007-jig-block-blind-bore",
  "spec_text": "A 50 mm cube-section jig block 25 mm tall. Bore a single 12 mm hole 15 mm deep into the centre of the top face. The hole does not break through the bottom.",
  "steps": [
    {
      "tool": "feature_body_create",
      "args": {
        "name": "Body"
      },
      "intent": "every PartDesign feature builds into a Body"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Outline",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Outline"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Outline",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              -25.0,
              -25.0
            ],
            "end": [
              25.0,
              -25.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              25.0,
              -25.0
            ],
            "end": [
              25.0,
              25.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              25.0,
              25.0
            ],
            "end": [
              -25.0,
              25.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              -25.0,
              25.0
            ],
            "end": [
              -25.0,
              -25.0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -25.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -25.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 50.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 50.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "50 mm square section"
    },
    {
      "tool": "feature_pad",
      "args": {
        "body": "Body",
        "profile": "Outline",
        "name": "Block",
        "length": {
          "value": 25.0,
          "unit": "mm"
        }
      },
      "intent": "extrude Outline 25 mm"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "BoreCentre",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for BoreCentre"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "BoreCentre",
        "geometry": [
          {
            "kind": "circle",
            "center": [
              0,
              0
            ],
            "radius": {
              "value": 6.0,
              "unit": "mm"
            }
          }
        ],
        "constraints": [
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "Diameter",
            "first": 0,
            "value": {
              "value": 12.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "12 mm bore on the axis"
    },
    {
      "tool": "feature_hole",
      "args": {
        "body": "Body",
        "profile": "BoreCentre",
        "name": "Bore",
        "diameter": {
          "value": 12.0,
          "unit": "mm"
        },
        "depth_type": "Dimension",
        "depth": {
          "value": 15.0,
          "unit": "mm"
        },
        "reversed": true
      },
      "intent": "bore 12.0 mm, 15.0 mm deep, not breaking through"
    },
    {
      "tool": "feature_set_parameters",
      "args": {
        "feature": "Bore",
        "parameters": {
          "DrillPoint": "Flat"
        }
      },
      "intent": "the spec's 15 mm deep bore is flat-bottomed, not a drill point"
    }
  ],
  "approved": true,
  "approved_by": "designer-actor",
  "rationale": "50 mm square, 25 mm tall. The bore is a Dimension hole 15 mm deep rather than ThroughAll, because the spec says it must not break through the 25 mm bottom, and its drill point is flattened so the bore is 15 mm deep as stated."
}
