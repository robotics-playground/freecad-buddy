{
  "schema": "fcb.design-plan/1",
  "spec_id": "g3-dev-019-offset-pivot-plate",
  "spec_text": "A 60 mm square pivot plate 6 mm thick. A single 10 mm through hole is positioned 20 mm along X and 15 mm along Y from the plate's corner datum. The hole is deliberately off-centre.",
  "steps": [
    {
      "tool": "feature_body_create",
      "args": {
        "name": "Body"
      },
      "intent": "every PartDesign feature builds into a Body"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Outline",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Outline"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Outline",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              0.0,
              0.0
            ],
            "end": [
              60.0,
              0.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              60.0,
              0.0
            ],
            "end": [
              60.0,
              60.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              60.0,
              60.0
            ],
            "end": [
              0.0,
              60.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              0.0,
              60.0
            ],
            "end": [
              0.0,
              0.0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 60.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 60.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "60 mm square, corner on the origin datum"
    },
    {
      "tool": "feature_pad",
      "args": {
        "body": "Body",
        "profile": "Outline",
        "name": "Plate",
        "length": {
          "value": 6.0,
          "unit": "mm"
        }
      },
      "intent": "extrude Outline 6 mm"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Pivot",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Pivot"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Pivot",
        "geometry": [
          {
            "kind": "circle",
            "center": [
              20,
              15
            ],
            "radius": {
              "value": 5.0,
              "unit": "mm"
            }
          }
        ],
        "constraints": [
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": 20.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": 15.0,
              "unit": "mm"
            }
          },
          {
            "type": "Diameter",
            "first": 0,
            "value": {
              "value": 10.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "10 mm hole at (20, 15) from the corner datum"
    },
    {
      "tool": "feature_hole",
      "args": {
        "body": "Body",
        "profile": "Pivot",
        "name": "PivotBore",
        "diameter": {
          "value": 10.0,
          "unit": "mm"
        },
        "depth_type": "ThroughAll",
        "reversed": true
      },
      "intent": "drill 10.0 mm through"
    },
    {
      "tool": "feature_datum",
      "args": {
        "body": "Body",
        "name": "PlateCornerDatum",
        "kind": "point",
        "attachment": {
          "kind": "mapped_name",
          "object": "Outline"
        },
        "map_mode": "ObjectOrigin"
      },
      "intent": "the corner datum the spec measures the hole position from"
    }
  ],
  "approved": true,
  "approved_by": "designer-actor",
  "rationale": "The spec measures from the plate's CORNER datum, not its centre, so this outline is laid with its corner on the sketch origin, and a datum point of that name is created there. The hole then sits at (20, 15) in the same frame, which is the off-centre position the spec asks for."
}
