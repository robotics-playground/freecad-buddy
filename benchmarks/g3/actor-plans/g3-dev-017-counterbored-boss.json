{
  "schema": "fcb.design-plan/1",
  "spec_id": "g3-dev-017-counterbored-boss",
  "spec_text": "A 30 mm square mounting boss 20 mm tall with a counterbored hole on its axis for an M6 socket-head screw: a 6.5 mm through hole with an 11 mm counterbore 6 mm deep in the top face.",
  "steps": [
    {
      "tool": "feature_body_create",
      "args": {
        "name": "Body"
      },
      "intent": "every PartDesign feature builds into a Body"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Outline",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Outline"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Outline",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              -15.0,
              -15.0
            ],
            "end": [
              15.0,
              -15.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              15.0,
              -15.0
            ],
            "end": [
              15.0,
              15.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              15.0,
              15.0
            ],
            "end": [
              -15.0,
              15.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              -15.0,
              15.0
            ],
            "end": [
              -15.0,
              -15.0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -15.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -15.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 30.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 30.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "30 mm square boss"
    },
    {
      "tool": "feature_pad",
      "args": {
        "body": "Body",
        "profile": "Outline",
        "name": "Boss",
        "length": {
          "value": 20.0,
          "unit": "mm"
        }
      },
      "intent": "extrude Outline 20 mm"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Axis",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Axis"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Axis",
        "geometry": [
          {
            "kind": "circle",
            "center": [
              0,
              0
            ],
            "radius": {
              "value": 3.25,
              "unit": "mm"
            }
          }
        ],
        "constraints": [
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "Diameter",
            "first": 0,
            "value": {
              "value": 6.5,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "6.5 mm through hole on axis"
    },
    {
      "tool": "feature_hole",
      "args": {
        "body": "Body",
        "profile": "Axis",
        "name": "Counterbore",
        "diameter": {
          "value": 6.5,
          "unit": "mm"
        },
        "depth_type": "ThroughAll",
        "cut_type": "Counterbore",
        "cut_diameter": {
          "value": 11.0,
          "unit": "mm"
        },
        "cut_depth": {
          "value": 6.0,
          "unit": "mm"
        },
        "reversed": true
      },
      "intent": "6.5 mm through hole with an 11 mm counterbore 6 mm deep"
    }
  ],
  "approved": true,
  "approved_by": "designer-actor",
  "rationale": "One PartDesign Hole carries both: a 6.5 mm ThroughAll bore with a Counterbore cut 11 mm across and 6 mm deep, which is exactly the M6 socket-head recess the spec describes."
}
