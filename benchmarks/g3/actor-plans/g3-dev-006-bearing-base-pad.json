            "first": 0,
            "value": {
              "value": 9.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 3,
            "value": {
              "value": 25.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 3,
            "value": {
              "value": 0.0,
              "unit": "mm"
