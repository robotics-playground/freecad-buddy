    {
      "tool": "feature_hole",
      "args": {
        "body": "Body",
        "profile": "Holes",
        "name": "Drill",
        "diameter": {
          "value": 9.0,
          "unit": "mm"
        },
        "depth_type": "ThroughAll",
        "reversed": true
      },
      "intent": "drill 9.0 mm through"
