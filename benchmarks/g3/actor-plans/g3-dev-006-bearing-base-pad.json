{
  "schema": "fcb.design-plan/1",
  "spec_id": "g3-dev-006-bearing-base-pad",
  "spec_text": "The base pad of a pillow-block bearing housing: a 70 mm by 30 mm pad, 10 mm thick, with two 9 mm mounting holes on the long centreline, 50 mm apart and symmetric about the pad centre.",
