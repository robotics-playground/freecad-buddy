{
  "schema": "fcb.design-plan/1",
  "spec_id": "g3-dev-005-rail-shim",
  "spec_text": "A shim strip 100 mm long, 20 mm wide and 3 mm thick. Drill two 6 mm through holes on the long centreline, each 10 mm from one end, so the holes are 80 mm apart.",
  "steps": [
    {
      "tool": "feature_body_create",
      "args": {
        "name": "Body"
      },
      "intent": "every PartDesign feature builds into a Body"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Outline",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Outline"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Outline",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              -50.0,
              -10.0
            ],
            "end": [
              50.0,
              -10.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              50.0,
              -10.0
            ],
            "end": [
              50.0,
              10.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              50.0,
              10.0
            ],
            "end": [
              -50.0,
              10.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              -50.0,
              10.0
            ],
            "end": [
              -50.0,
              -10.0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -50.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -10.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 100.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 20.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "100 x 20 outline"
    },
    {
      "tool": "feature_pad",
      "args": {
        "body": "Body",
        "profile": "Outline",
        "name": "Plate",
        "length": {
          "value": 3.0,
          "unit": "mm"
        }
      },
      "intent": "extrude Outline 3 mm"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Holes",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Holes"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Holes",
        "geometry": [
          {
            "kind": "circle",
            "center": [
              -40,
              0
            ],
            "radius": {
              "value": 3.0,
              "unit": "mm"
            }
          },
          {
            "kind": "circle",
            "center": [
              40,
              0
            ],
            "radius": {
              "value": 3.0,
              "unit": "mm"
            }
          }
        ],
        "constraints": [
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": -40.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 3,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "Diameter",
            "first": 0,
            "value": {
              "value": 6.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 3,
            "value": {
              "value": 40.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 3,
            "value": {
              "value": 0.0,
              "unit": "mm"
            }
          },
          {
            "type": "Diameter",
            "first": 1,
            "value": {
              "value": 6.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "2 hole centres"
    },
    {
      "tool": "feature_hole",
      "args": {
        "body": "Body",
        "profile": "Holes",
        "name": "Drill",
        "diameter": {
          "value": 6.0,
          "unit": "mm"
        },
        "depth_type": "ThroughAll",
        "reversed": true
      },
      "intent": "drill 6.0 mm through"
    }
  ],
  "approved": true,
  "approved_by": "designer-actor",
  "rationale": "100x20x3 strip. Each hole is 10 mm from its end, so on a centred outline they sit at +-40 on the long centreline and are 80 mm apart, as the spec states."
}
