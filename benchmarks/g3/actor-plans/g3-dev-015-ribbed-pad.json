            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
