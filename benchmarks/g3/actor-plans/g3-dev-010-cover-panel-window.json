{
  "schema": "fcb.design-plan/1",
  "spec_id": "g3-dev-010-cover-panel-window",
  "spec_text": "An enclosure cover panel 120 mm by 80 mm and 3 mm thick with a rectangular window 60 mm by 30 mm cut through the centre of the panel.",
  "steps": [
    {
      "tool": "feature_body_create",
      "args": {
        "name": "Body"
      },
      "intent": "every PartDesign feature builds into a Body"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Outline",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Outline"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Outline",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              -60.0,
              -40.0
            ],
            "end": [
              60.0,
              -40.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              60.0,
              -40.0
            ],
            "end": [
              60.0,
              40.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              60.0,
              40.0
            ],
            "end": [
              -60.0,
              40.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              -60.0,
              40.0
            ],
            "end": [
              -60.0,
              -40.0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -60.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -40.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 120.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 80.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "120x80 panel outline"
    },
    {
      "tool": "feature_pad",
      "args": {
        "body": "Body",
        "profile": "Outline",
        "name": "Panel",
        "length": {
          "value": 3.0,
          "unit": "mm"
        }
      },
      "intent": "extrude Outline 3 mm"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Window",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Window"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Window",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              -30.0,
              -15.0
            ],
            "end": [
              30.0,
              -15.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              30.0,
              -15.0
            ],
            "end": [
              30.0,
              15.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              30.0,
              15.0
            ],
            "end": [
              -30.0,
              15.0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              -30.0,
              15.0
            ],
            "end": [
              -30.0,
              -15.0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "DistanceX",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -30.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": -1,
            "first_pos": 1,
            "second": 0,
            "second_pos": 1,
            "value": {
              "value": -15.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 60.0,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 30.0,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "60x30 window, centred"
    },
    {
      "tool": "feature_pocket",
      "args": {
        "body": "Body",
        "profile": "Window",
        "name": "WindowCut",
        "up_to": "ThroughAll",
        "reversed": true
      },
      "intent": "cut Window right through"
    }
  ],
  "approved": true,
  "approved_by": "designer-actor",
  "rationale": "120x80x3 panel with a 60x30 rectangular window. Both rectangles are centred on the origin, so the window is centred on the panel, and the pocket is ThroughAll because the window is cut through."
}
