{
  "schema": "fcb.design-plan/1",
  "spec_id": "g3-dev-004-round-standoff",
  "spec_text": "A round standoff 20 mm long with a 10 mm outside diameter and a 3.2 mm through bore for an M3 screw. The bore is coaxial with the outside diameter.",
  "steps": [
    {
      "tool": "feature_body_create",
      "args": {
        "name": "Body"
      },
      "intent": "every PartDesign feature builds into a Body"
    },
    {
      "tool": "sketch_create",
      "args": {
        "name": "Outline",
        "plane": "XY",
        "body": "Body"
      },
      "intent": "profile plane for Outline"
    },
    {
      "tool": "sketch_add_geometry",
      "args": {
        "sketch": "Outline",
        "geometry": [
          {
            "kind": "circle",
            "center": [
              0,
              0
            ],
            "radius": {
              "value": 5.0,
              "unit": "mm"
            }
          },
          {
            "kind": "circle",
            "center": [
              0,
              0
            ],
            "radius": {
              "value": 1.6,
              "unit": "mm"
            }
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 3,
            "second": -1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 3,
            "second": -1,
            "second_pos": 1
          },
          {
            "type": "Diameter",
            "first": 0,
            "value": {
              "value": 10.0,
              "unit": "mm"
            }
          },
          {
            "type": "Diameter",
            "first": 1,
            "value": {
              "value": 3.2,
              "unit": "mm"
            }
          }
        ]
      },
      "intent": "10 mm outside, 3.2 mm bore"
    },
    {
      "tool": "feature_pad",
      "args": {
        "body": "Body",
        "profile": "Outline",
        "name": "Standoff",
        "length": {
          "value": 20.0,
          "unit": "mm"
        }
      },
      "intent": "extrude Outline 20 mm"
    }
  ],
  "approved": true,
  "approved_by": "designer-actor",
  "rationale": "10 mm outside diameter, 3.2 mm M3 clearance bore, 20 mm long. Both circles are pinned to the origin, so the bore is coaxial with the outside diameter by construction."
}
