    },
    {
      "step": "given_tree",
      "path": "text",
      "regex": "\\[SKETCH\\] Sketch\\b"
    },
    {
      "step": "given_tree",
      "path": "text",
      "regex": "^(?![\\s\\S]*\\] Pad\\b)"
    },
    {
      "step": "pad",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "pad",
      "path": "detail",
      "equals": null
    },
    {
      "step": "pad",
      "path": "structured_content.mutation.rolled_back",
      "equals": false
    },
    {
      "step": "pad",
      "path": "structured_content.mutation.fingerprint_after.digest",
      "regex": "^[0-9a-f]{64}$"
    },
    {
      "step": "pad",
      "path": "structured_content.mutation.fingerprint_after.serializer",
      "absent": false
    },
    {
      "step": "pad",
      "path": "structured_content.mutation.fingerprint_before.digest",
      "equals": "$pad_preview.structured_content.diff.fingerprint_before"
    },
