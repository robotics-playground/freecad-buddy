      "step": "mass",
      "path": "structured_content.volume.value",
      "approx": 12000.0,
      "tolerance": 12.0
    },
    {
      "step": "pad_preview",
      "path": "structured_content.diff.deltas.volume.after",
      "approx": 12000.0,
      "tolerance": 12.0
    },
    {
      "step": "pad_preview",
      "path": "structured_content.preview_id",
      "regex": "^fcb-preview:[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
