{
  "id": "TC-02-12",
  "tc": "TC-02",
  "title": "query_dependencies max_edges truncation and rejection",
  "steps": [
    {
      "name": "create",
      "mcp": "document_create",
      "args": {
        "label": "tc-02-12-deps"
      }
    },
    {
      "name": "build",
      "mcp": "script_exec",
      "args": {
        "doc": "$create.structured_content.doc",
        "code": "box = doc.addObject('Part::Box', 'Box')\ncylinder = doc.addObject('Part::Cylinder', 'Cylinder')\ncylinder.Radius = 3\ncylinder.Height = 20\ncylinder.Placement = App.Placement(App.Vector(5, 5, 0), App.Rotation())\nfusion = doc.addObject('Part::Fuse', 'Fusion')\nfusion.Base = box\nfusion.Tool = cylinder\ndoc.recompute()\nresult = round(fusion.Shape.Volume, 3)"
      }
    },
    {
      "name": "full",
      "mcp": "query_dependencies",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    },
    {
      "name": "capped",
      "mcp": "query_dependencies",
      "args": {
        "doc": "$create.structured_content.doc",
        "max_edges": 1
      }
    },
    {
      "name": "zero",
      "mcp": "query_dependencies",
      "args": {
        "doc": "$create.structured_content.doc",
        "max_edges": 0
      }
    },
    {
      "name": "negative",
      "mcp": "query_dependencies",
      "args": {
        "doc": "$create.structured_content.doc",
        "max_edges": -5
      }
    },
    {
      "name": "fraction",
      "mcp": "query_dependencies",
      "args": {
        "doc": "$create.structured_content.doc",
        "max_edges": 1.5
      }
    }
  ],
  "expect": [
    {
      "step": "build",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "full",
      "path": "structured_content.truncated",
      "equals": false
    },
    {
      "step": "full",
      "path": "structured_content.returned_edges",
      "equals": "$full.structured_content.total_edges"
    },
    {
      "step": "capped",
      "path": "structured_content.edges.0",
      "equals": "$full.structured_content.edges.0"
    },
    {
      "step": "capped",
      "path": "structured_content.edges.1",
      "absent": true
    },
    {
      "step": "capped",
      "path": "structured_content.returned_edges",
      "equals": 1
    },
    {
      "step": "capped",
      "path": "structured_content.truncated",
      "equals": true
    },
    {
      "step": "capped",
      "path": "structured_content.total_edges",
      "equals": "$full.structured_content.total_edges"
    },
    {
      "step": "zero",
      "path": "is_error",
      "equals": true
    },
    {
      "step": "zero",
      "path": "text",
      "regex": "Input validation error: 0 is less than the minimum of 1"
    },
    {
      "step": "negative",
      "path": "is_error",
      "equals": true
    },
    {
      "step": "negative",
      "path": "text",
      "regex": "Input validation error: -5 is less than the minimum of 1"
    },
    {
      "step": "fraction",
      "path": "is_error",
      "equals": true
    },
    {
      "step": "fraction",
      "path": "text",
      "regex": "Input validation error: 1\\.5 is not of type 'integer'"
    }
  ],
  "probe": {
    "tolerance": 1.3,
    "active_document": "tc_02_12_deps",
    "documents": {
      "tc_02_12_deps": {
        "objects": {
          "Fusion": {
            "type": "Part::Fuse",
            "visibility": true,
            "valid": true,
            "volume": 1282.743
          }
        }
      }
    }
  },
  "agent_check": "The test case frames the model with the GUI Fit All toolbar button before and after the refused calls, which the runner cannot press; click Fit All, capture the window and judge that the model is the same picture with no dialog and no document added or closed. The script does not check these Thens; check each one in the gate run: Given: whole-document query_dependencies total_edges >= 2 (not encoded) (comparison op); Given: model framed with GUI Fit All and a before capture (GUI action)."
}
