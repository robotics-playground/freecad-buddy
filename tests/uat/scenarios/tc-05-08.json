{
  "id": "TC-05-08",
  "tc": "TC-05",
  "title": "Undo unavailable is recorded, not misread as the #6031 defect",
  "launch": {
    "FREECAD_BUDDY_AUTO_APPROVE": "0"
  },
  "steps": [
