    {
      "name": "prev_pad",
      "mcp": "preview_dry_run",
      "args": {
        "doc": "$create.structured_content.doc",
        "operation": {
          "tool": "feature_pad",
          "args": {
            "body": "Body",
            "profile": "Sketch",
            "name": "Pad",
            "length": {
              "value": 30,
              "unit": "mm"
            }
          }
        }
      }
    },
    {
      "name": "pad",
      "mcp": "feature_pad",
      "args": {
        "doc": "$create.structured_content.doc",
        "body": "Body",
        "profile": "Sketch",
        "name": "Pad",
        "length": {
          "value": 30,
          "unit": "mm"
        },
        "confirm": {
          "preview_id": "$prev_pad.structured_content.preview_id"
        }
      }
    },
    {
      "name": "mass_given",
      "mcp": "query_mass_properties",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "Pad"
      }
    },
    {
      "name": "undo_off",
      "mcp": "script_exec",
      "args": {
        "doc": "$create.structured_content.doc",
        "code": "from freecad_buddy.usecases import shim\nshim._fcb_enable_undo = shim.enable_undo\nshim.enable_undo = lambda d: False\ndoc.UndoMode = 0\nresult = doc.UndoMode"
      }
    },
    {
      "name": "undo_refused",
      "mcp": "document_undo",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    },
    {
      "name": "fit_before",
      "mcp": "view_fit_viewport",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    },
    {
      "name": "prev_fillet",
      "mcp": "preview_dry_run",
      "args": {
        "doc": "$create.structured_content.doc",
        "operation": {
          "tool": "feature_fillet",
          "args": {
            "body": "Body",
            "base": "Pad",
            "name": "Fillet",
            "edges": [
              {
                "kind": "mapped_name",
                "object": "Pad",
                "mapped_name": "Edge1"
              }
            ],
            "radius": {
              "value": 500,
              "unit": "mm"
            }
          }
        }
      }
    },
    {
      "name": "fillet",
      "mcp": "feature_fillet",
      "args": {
        "doc": "$create.structured_content.doc",
        "body": "Body",
        "base": "Pad",
        "name": "Fillet",
        "edges": [
          {
            "kind": "mapped_name",
            "object": "Pad",
            "mapped_name": "Edge1"
          }
        ],
        "radius": {
          "value": 500,
          "unit": "mm"
        },
        "confirm": {
          "preview_id": "$prev_fillet.structured_content.preview_id"
        }
      }
    },
    {
      "name": "tree",
      "mcp": "query_tree_summary",
      "args": {
        "doc": "$create.structured_content.doc",
        "depth": 3
      }
    },
    {
      "name": "mass_after",
      "mcp": "query_mass_properties",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "Pad"
      }
    },
    {
      "name": "undo_on",
      "mcp": "script_exec",
      "args": {
        "doc": "$create.structured_content.doc",
        "code": "from freecad_buddy.usecases import shim\nshim.enable_undo = shim._fcb_enable_undo\ndoc.UndoMode = 1\nresult = shim.enable_undo(doc)"
      }
    },
    {
      "name": "prev_repeat",
      "mcp": "preview_dry_run",
      "args": {
        "doc": "$create.structured_content.doc",
        "operation": {
          "tool": "feature_fillet",
          "args": {
            "body": "Body",
            "base": "Pad",
            "name": "Fillet",
            "edges": [
              {
                "kind": "mapped_name",
                "object": "Pad",
                "mapped_name": "Edge1"
              }
            ],
            "radius": {
              "value": 500,
              "unit": "mm"
            }
          }
        }
      }
    },
    {
      "name": "repeat",
      "mcp": "feature_fillet",
      "args": {
        "doc": "$create.structured_content.doc",
        "body": "Body",
        "base": "Pad",
        "name": "Fillet",
        "edges": [
          {
            "kind": "mapped_name",
            "object": "Pad",
            "mapped_name": "Edge1"
          }
        ],
        "radius": {
          "value": 500,
          "unit": "mm"
        },
        "confirm": {
          "preview_id": "$prev_repeat.structured_content.preview_id"
