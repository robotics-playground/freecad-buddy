      "name": "fit",
      "mcp": "view_fit_viewport",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    }
  ],
  "expect": [
    {
      "step": "body",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "sketch",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "geometry",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "pad",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "mass_given",
      "path": "structured_content.volume.value",
      "approx": 12000.0,
      "tolerance": 12.0
    },
    {
      "step": "undo_off",
      "path": "structured_content.value_repr",
      "equals": "0"
    },
    {
      "step": "undo_refused",
      "path": "status",
      "equals": "INVALID_INPUT"
    },
    {
      "step": "undo_refused",
      "path": "detail.message",
      "equals": "undo is unavailable on $create.structured_content.name: the document reports UndoMode 0"
    },
    {
      "step": "fit_before",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "fillet",
      "path": "structured_content.mutation.post_verify.explanation",
      "regex": "; undo unavailable on this document$"
    },
    {
      "step": "fillet",
      "path": "structured_content.mutation.rollback_proven",
      "equals": "rolled_back_via_snapshot"
    },
    {
      "step": "fillet",
      "path": "structured_content.mutation.rolled_back",
      "equals": true
    },
    {
      "step": "fillet",
      "path": "structured_content.mutation.changed",
      "equals": []
    },
    {
      "step": "tree",
      "path": "text",
      "regex": "^(?![\\s\\S]*\\] Fillet\\b)"
    },
    {
      "step": "mass_after",
      "path": "structured_content.volume.value",
      "approx": 12000.0,
      "tolerance": 12.0
    },
    {
      "step": "undo_on",
      "path": "structured_content.value_repr",
      "equals": "True"
    },
    {
      "step": "repeat",
      "path": "structured_content.mutation.post_verify.explanation",
      "regex": "^(?![\\s\\S]*undo unavailable)"
    },
    {
      "step": "fit",
      "path": "status",
      "equals": "OK"
    }
  ],
  "probe": {
    "tolerance": 12.0,
    "active_document": "TC0508",
    "documents": {
      "TC0508": {
        "objects": {
          "Pad": {
            "visibility": true,
            "valid": true,
            "volume": 12000
          }
        }
