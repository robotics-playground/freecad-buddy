{
  "id": "TC-04-03",
  "tc": "TC-04",
  "title": "feature_pad midplane straddles the sketch plane",
  "steps": [
    {
      "name": "create",
      "mcp": "document_create",
      "args": {
        "label": "Mid"
      }
    },
    {
      "name": "mid_body",
      "mcp": "feature_body_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "MidBody"
      }
    },
    {
      "name": "mid_sketch",
      "mcp": "sketch_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "MidProfile",
        "plane": "XY",
        "body": "MidBody"
      }
    },
    {
      "name": "mid_geometry",
      "mcp": "sketch_add_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "MidProfile",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              0,
              0
            ],
            "end": [
              20,
              0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              20,
              0
            ],
            "end": [
              20,
              30
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              20,
              30
            ],
            "end": [
              0,
              30
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              0,
              30
            ],
            "end": [
              0,
              0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 20,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 30,
              "unit": "mm"
            }
          },
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 1,
            "second": -1,
            "second_pos": 1
          }
        ]
      }
    },
    {
      "name": "sketch_check",
      "mcp": "verify_sketch",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "MidProfile"
      }
    },
    {
      "name": "pad",
      "mcp": "feature_pad",
      "args": {
        "doc": "$create.structured_content.doc",
        "body": "MidBody",
        "profile": "MidProfile",
        "name": "MidPad",
        "length": {
          "value": 10,
          "unit": "mm"
        },
        "midplane": true
      }
    },
    {
      "name": "mass",
      "mcp": "query_mass_properties",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "MidPad"
      }
    },
    {
      "name": "placement",
      "mcp": "query_placement",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "MidPad"
      }
    },
    {
      "name": "shape",
      "mcp": "verify_shape",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "MidPad"
      }
    },
    {
      "name": "fit",
      "mcp": "view_fit_viewport",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    }
  ],
  "expect": [
    {
      "step": "sketch_check",
      "path": "structured_content.subject.dof",
      "equals": 0
    },
    {
      "step": "pad",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "pad",
      "path": "structured_content.mutation.rolled_back",
      "equals": false
    },
    {
      "step": "mass",
      "path": "structured_content.volume.value",
      "approx": 6000.0,
      "tolerance": 6.0
    },
    {
      "step": "pad",
      "path": "structured_content.feature_state.shape_summary.bbox.0",
      "approx": 20.0,
      "tolerance": 0.02
    },
    {
      "step": "pad",
      "path": "structured_content.feature_state.shape_summary.bbox.1",
      "approx": 30.0,
      "tolerance": 0.03
    },
    {
      "step": "pad",
      "path": "structured_content.feature_state.shape_summary.bbox.2",
      "approx": 10.0,
      "tolerance": 0.01
    },
    {
      "step": "mass",
      "path": "structured_content.bbox.zmin.value",
      "approx": -5.0,
      "tolerance": 0.005
    },
    {
      "step": "mass",
      "path": "structured_content.bbox.zmax.value",
      "approx": 5.0,
      "tolerance": 0.005
    },
    {
      "step": "mass",
      "path": "structured_content.com.z.value",
      "approx": 0.0,
      "tolerance": 0.005
    },
    {
      "step": "shape",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "fit",
      "path": "status",
      "equals": "OK"
    }
  ],
  "probe": {
    "tolerance": 0.01,
    "active_document": "Mid",
    "documents": {
      "Mid": {
        "objects": {
          "MidPad": {
            "visibility": true,
            "valid": true,
            "volume": 6000
          }
        }
      }
    },
    "view": {
      "clipped": false
    }
  },
  "cross": [
    {
      "mcp": "mass.structured_content.volume.value",
      "probe": "documents.Mid.objects.MidPad.shape.volume",
      "tolerance": 0.01
    }
  ],
  "pixel": {
    "samples": [
      "Mid.MidPad"
    ],
    "extent": {
      "min_fraction": 0.5,
      "inside": true
    }
  },
  "agent_check": "Visual Then of TC-04-03: the solid straddles the XY plane, half above and half below. The origin planes are hidden in the capture, so the plane is not drawn; the 2026-10-03-04 run judged this with FreeCAD View > Toggle axis cross. Toggle the axis cross, capture, and confirm the origin sits at mid-height of the 20 x 30 x 10 block."
}
