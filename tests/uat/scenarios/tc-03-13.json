{
  "id": "TC-03-13",
  "tc": "TC-03",
  "title": "sketch_add_external_geometry projects a model edge",
  "steps": [
    {
      "name": "create",
      "mcp": "document_create",
      "args": {
        "label": "BracketPlate"
      }
    },
    {
      "name": "body",
      "mcp": "feature_body_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "PlateBody"
      }
    },
    {
      "name": "profile",
      "mcp": "sketch_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "PlateProfile",
        "plane": "XY",
        "body": "PlateBody"
      }
    },
    {
      "name": "rect",
      "mcp": "sketch_add_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "PlateProfile",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              0,
              0
            ],
            "end": [
              60,
              0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              60,
              0
            ],
            "end": [
              60,
              40
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              60,
              40
            ],
            "end": [
              0,
              40
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              0,
              40
            ],
            "end": [
              0,
              0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 1,
            "second": -1,
            "second_pos": 1
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 60,
              "unit": "mm"
            },
            "name": "PlateWidth"
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 40,
              "unit": "mm"
            },
            "name": "PlateDepth"
          }
        ]
      }
    },
    {
      "name": "pad",
      "mcp": "feature_pad",
      "args": {
        "doc": "$create.structured_content.doc",
        "body": "PlateBody",
        "profile": "PlateProfile",
        "name": "PlatePad",
        "length": {
          "value": 5,
          "unit": "mm"
        }
      }
    },
    {
      "name": "mass_given",
      "mcp": "query_mass_properties",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "PlatePad"
      }
    },
    {
      "name": "boss",
      "mcp": "sketch_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "BossProfile",
        "face": {
          "kind": "mapped_name",
          "object": "PlatePad",
          "mapped_name": "Face6"
        },
        "body": "PlateBody"
      }
    },
    {
      "name": "boss_verify",
      "mcp": "verify_sketch",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "BossProfile"
      }
    },
    {
      "name": "edge_oracle",
      "mcp": "script_exec",
      "args": {
        "doc": "$create.structured_content.doc",
        "code": "e = doc.getObject('PlatePad').Shape.getElement('Edge3')\nresult = round(e.Length, 3)"
      }
    },
    {
      "name": "project",
      "mcp": "sketch_add_external_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "BossProfile",
        "edge": {
          "kind": "mapped_name",
          "object": "PlatePad",
          "mapped_name": "Edge3"
        }
      }
    },
    {
      "name": "verify",
      "mcp": "verify_sketch",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "BossProfile"
      }
    },
    {
      "name": "dependencies",
      "mcp": "query_dependencies",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "BossProfile"
      }
    },
    {
      "name": "unknown_source",
      "mcp": "sketch_add_external_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "BossProfile",
        "edge": {
          "kind": "mapped_name",
          "object": "NoSuchPad",
          "mapped_name": "Edge1"
        }
      }
    },
    {
      "name": "face_selector",
      "mcp": "sketch_add_external_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "BossProfile",
        "edge": {
          "kind": "mapped_name",
          "object": "PlatePad",
          "mapped_name": "Face1"
        }
      }
    },
    {
      "name": "fit",
      "mcp": "view_fit_viewport",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    }
  ],
  "expect": [
    {
      "step": "create",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "body",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "profile",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "rect",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "rect",
      "path": "structured_content.mutation.rolled_back",
      "equals": false
    },
    {
      "step": "pad",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "pad",
      "path": "structured_content.mutation.rolled_back",
      "equals": false
    },
    {
      "step": "mass_given",
      "path": "structured_content.volume.value",
      "approx": 12000.0,
      "tolerance": 12.0
    },
    {
      "step": "boss",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "boss",
      "path": "structured_content.mutation.rolled_back",
      "equals": false
    },
    {
      "step": "boss_verify",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "edge_oracle",
      "path": "structured_content.value_repr",
      "equals": "60.0"
    },
    {
      "step": "project",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "project",
      "path": "structured_content.mutation.rolled_back",
      "equals": false
    },
    {
      "step": "verify",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "verify",
      "path": "structured_content.subject.dof",
      "equals": 0
    },
    {
      "step": "project",
      "path": "structured_content.mutation.post_verify.tnp_audit.status",
      "equals": "CLEAN"
    },
    {
      "step": "project",
      "path": "structured_content.mutation.post_verify.tnp_audit.findings",
      "equals": []
    },
    {
      "step": "project",
      "path": "structured_content.mutation.post_verify.tnp_audit.counts.REPOINTED",
      "absent": true
    },
    {
      "step": "project",
      "path": "structured_content.mutation.post_verify.tnp_audit.counts.BROKEN",
      "absent": true
    },
    {
      "step": "project",
      "path": "structured_content.mutation.post_verify.tnp_audit.counts.UNSUPPORTED",
      "absent": true
    },
    {
      "step": "project",
      "path": "structured_content.mutation.post_verify.tnp_audit.element_map_version",
      "regex": "\\S"
    },
    {
      "step": "dependencies",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "dependencies",
      "path": "structured_content.out_list",
      "equals": [
        "PlatePad"
      ]
    },
    {
      "step": "unknown_source",
      "path": "status",
      "equals": "INVALID_INPUT"
    },
    {
      "step": "unknown_source",
      "path": "detail.message",
      "equals": "unknown object in edge selector: NoSuchPad"
    },
    {
      "step": "face_selector",
      "path": "status",
      "equals": "INVALID_INPUT"
    },
    {
      "step": "face_selector",
      "path": "detail.message",
      "regex": "resolves to a Face, not an Edge"
    },
    {
      "step": "fit",
      "path": "status",
      "equals": "OK"
    }
  ],
  "probe": {
    "tolerance": 0.01,
    "active_document": "BracketPlate",
    "documents": {
      "BracketPlate": {
        "objects": {
          "PlatePad": {
            "visibility": true,
            "valid": true,
            "volume": 12000
          }
        }
      }
    },
    "view": {
      "clipped": false
    }
  },
  "pixel": {
    "samples": [
      "BracketPlate.PlatePad"
    ],
    "extent": {
      "min_fraction": 0.5,
      "inside": true
    }
  },
  "cross": [
    {
      "mcp": "mass_given.structured_content.volume.value",
      "probe": "documents.BracketPlate.objects.PlatePad.shape.volume",
      "tolerance": 0.01
    }
  ],
  "agent_check": "External geometry is drawn only in Sketcher edit mode, which the runner does not open, and the runner takes no before capture: open BossProfile in edit mode (test case Preconditions), capture the window and judge one projected curve in the external-geometry colour lying along a 60 mm boundary edge of the shaded plate, on the plate and not offset; the solid unchanged; no error dialog. The script does not check these Thens; check each one in the gate run: Given: pre-projection state captured (tc-03-13-before.png) (GUI action); tnp_audit counts.PASS >= 1 (not encoded) (comparison op); whole-document query_dependencies has edge BossProfile -> PlatePad (encoded as the object form, out_list equals [PlatePad]) (comparison op)."
}
