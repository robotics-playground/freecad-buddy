            "second_pos": 2,
            "value": {
              "value": 40,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceX",
            "first": 1,
            "first_pos": 1,
            "value": {
              "value": 10,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "value": {
              "value": 30,
              "unit": "mm"
            }
          }
