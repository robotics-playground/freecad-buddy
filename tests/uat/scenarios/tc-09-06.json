  "expect": [
    {
      "step": "add",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "add",
      "path": "structured_content.mutation.rolled_back",
      "equals": false
    },
    {
      "step": "given",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "given",
      "path": "structured_content.geometry.3.index",
      "equals": 3
    },
    {
      "step": "given",
      "path": "structured_content.geometry.4",
      "absent": true
    },
    {
      "step": "fit_before",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "empty",
      "path": "text",
      "regex": "^Input validation error: \\[\\] should be non-empty"
    },
    {
      "step": "empty",
      "path": "is_error",
      "equals": true
    },
    {
      "step": "short",
      "path": "text",
      "regex": "^Input validation error: \\[0\\] is too short"
    },
    {
      "step": "short",
      "path": "is_error",
      "equals": true
    },
    {
      "step": "long",
      "path": "text",
      "regex": "^Input validation error: \\[0, 0, 0, 0\\] is too long"
    },
    {
      "step": "long",
      "path": "is_error",
      "equals": true
    },
    {
      "step": "short",
      "path": "status",
      "absent": true
    },
    {
      "step": "long",
      "path": "status",
      "absent": true
    },
    {
      "step": "export",
      "path": "schema",
      "equals": "fcb.result-envelope/1"
    },
    {
      "step": "info",
      "path": "structured_content.geometry.3.index",
      "equals": 3
    },
    {
      "step": "info",
      "path": "structured_content.geometry.4",
      "absent": true
    },
    {
      "step": "fit",
      "path": "status",
      "equals": "OK"
    }
  ],
  "probe": {
    "active_document": "TC0906",
    "documents": {
      "TC0906": {
        "objects": {
          "Sketch": {
            "type": "Sketcher::SketchObject",
            "visibility": true
          }
        }
      }
    },
    "view": {
      "clipped": false
    }
  },
  "agent_check": "The runner takes no before capture: capture the framed sketch before the refused calls and compare it with the runner's capture; the same sketch, no new line segment, the two images identical by eye, no error dialog or modal."
}
