{
  "id": "TC-09-06",
  "tc": "TC-09",
  "title": "Empty arrays are rejected where `minItems` applies",
  "steps": [
    {
      "name": "create",
      "mcp": "document_create",
      "args": {
        "label": "TC0906"
      }
    },
    {
      "name": "body",
      "mcp": "feature_body_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "Body"
      }
    },
    {
      "name": "sketch",
      "mcp": "sketch_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "Sketch",
        "plane": "XY",
        "body": "Body"
      }
    },
    {
      "name": "add",
      "mcp": "sketch_add_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "Sketch",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              0,
              0
            ],
            "end": [
              20,
              0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              20,
              0
            ],
            "end": [
              20,
              20
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              20,
              20
            ],
            "end": [
              0,
              20
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              0,
              20
            ],
            "end": [
              0,
              0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 1,
            "second": -1,
            "second_pos": 1
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 20,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 20,
              "unit": "mm"
            }
          }
        ]
      }
    },
    {
      "name": "given",
      "mcp": "query_sketch_info",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "Sketch"
      }
    },
    {
      "name": "fit_before",
      "mcp": "view_fit_viewport",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    },
    {
      "name": "empty",
      "mcp": "sketch_add_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "Sketch",
        "geometry": []
      }
    },
    {
      "name": "short",
      "mcp": "sketch_add_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "Sketch",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              0
            ],
            "end": [
              10,
              0
            ]
          }
        ]
      }
    },
    {
      "name": "long",
      "mcp": "sketch_add_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "Sketch",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              0,
              0,
              0,
              0
            ],
            "end": [
              10,
              0
            ]
          }
        ]
      }
    },
    {
      "name": "export",
      "mcp": "export_step",
      "args": {
        "doc": "$create.structured_content.doc",
        "path": "$RUN_DIR/evidence/tc-09-06-e.step",
        "objects": []
      }
    },
    {
      "name": "info",
      "mcp": "query_sketch_info",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "Sketch"
      }
    },
    {
      "name": "fit",
      "mcp": "view_fit_viewport",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    }
