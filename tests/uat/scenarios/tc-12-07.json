{
  "id": "TC-12-07",
  "tc": "TC-12",
  "title": "A GUI-side recompute agrees with the bridge",
  "steps": [
    {
      "name": "create",
      "mcp": "document_create",
      "args": {
        "label": "TC1207"
      }
    },
    {
      "name": "body",
      "mcp": "feature_body_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "Body"
      }
    },
    {
      "name": "sketch",
      "mcp": "sketch_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "Sketch",
        "plane": "XY",
        "body": "Body"
      }
    },
    {
      "name": "rect",
      "mcp": "sketch_add_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "Sketch",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              0,
              0
            ],
            "end": [
              20,
              0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              20,
              0
            ],
            "end": [
              20,
              10
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              20,
              10
            ],
            "end": [
              0,
              10
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              0,
              10
            ],
            "end": [
              0,
              0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 1,
            "second": -1,
            "second_pos": 1
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 20,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 10,
              "unit": "mm"
            }
          }
        ]
      }
    },
    {
      "name": "pad",
      "mcp": "feature_pad",
      "args": {
        "doc": "$create.structured_content.doc",
        "body": "Body",
        "profile": "Sketch",
        "name": "Pad",
        "length": {
          "value": 5,
          "unit": "mm"
        }
      }
    },
    {
      "name": "mass_given",
      "mcp": "query_mass_properties",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "Pad"
      }
    },
    {
      "name": "clean",
      "mcp": "verify_recompute",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    },
    {
      "name": "touch",
      "mcp": "script_exec",
      "args": {
        "doc": "$create.structured_content.doc",
        "recompute": false,
        "code": "doc.getObject('Pad').Length = 8\nresult = doc.getObject('Pad').State"
      }
    },
    {
      "name": "shot",
      "mcp": "query_screenshot",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    },
    {
      "menu": [
        "Edit",
        "Recompute"
      ]
    },
    {
      "name": "gui_recomputed",
      "mcp": "script_exec",
      "args": {
        "doc": "$create.structured_content.doc",
        "code": "result = 'Touched' in doc.getObject('Pad').State"
      }
    },
    {
      "name": "verify",
      "mcp": "verify_recompute",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    },
    {
      "name": "recompute",
      "mcp": "document_recompute",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    },
    {
      "name": "mass",
      "mcp": "query_mass_properties",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "Pad"
      }
    },
    {
      "name": "fit",
      "mcp": "view_fit_viewport",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    }
  ],
  "expect": [
    {
      "step": "create",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "body",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "sketch",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "rect",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "rect",
      "path": "structured_content.mutation.rolled_back",
      "equals": false
    },
    {
      "step": "pad",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "pad",
      "path": "structured_content.mutation.rolled_back",
      "equals": false
    },
    {
      "step": "mass_given",
      "path": "structured_content.volume.value",
      "approx": 1000.0,
      "tolerance": 1.0
    },
    {
      "step": "clean",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "clean",
      "path": "structured_content.subject.failing_objects",
      "equals": []
    },
    {
      "step": "touch",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "touch",
      "path": "structured_content.value_repr",
      "equals": "['Touched']"
    },
    {
      "step": "shot",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "shot",
      "path": "structured_content.render.dirty_document",
      "equals": true
    },
    {
      "step": "shot",
      "path": "text",
      "regex": "Document dirty \\(pending/broken recompute\\)"
    },
    {
      "step": "gui_recomputed",
      "path": "structured_content.value_repr",
      "equals": "False"
    },
    {
      "step": "verify",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "verify",
      "path": "structured_content.subject.failing_objects",
      "equals": []
    },
    {
      "step": "recompute",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "recompute",
      "path": "structured_content.touched",
      "equals": 0
    },
    {
      "step": "recompute",
      "path": "structured_content.errors",
      "equals": []
    },
    {
      "step": "mass",
      "path": "structured_content.volume.value",
      "approx": 1600.0,
      "tolerance": 1.6
    },
    {
      "step": "fit",
      "path": "status",
      "equals": "OK"
    }
  ],
  "probe": {
    "tolerance": 0.01,
    "active_document": "TC1207",
    "documents": {
      "TC1207": {
        "objects": {
          "Pad": {
            "visibility": true,
