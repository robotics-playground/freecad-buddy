{
  "id": "TC-08-04",
  "tc": "TC-08",
  "title": "A preview of a failing operation is still a successful preview",
  "launch": {
    "FREECAD_BUDDY_AUTO_APPROVE": "0"
  },
  "steps": [
    {
      "name": "create",
      "mcp": "document_create",
      "args": {
        "label": "TC0804"
      }
    },
    {
      "name": "prev_body",
      "mcp": "preview_dry_run",
      "args": {
        "doc": "$create.structured_content.doc",
        "operation": {
          "tool": "feature_body_create",
          "args": {
            "name": "Body"
          }
        }
      }
    },
    {
      "name": "body",
      "mcp": "feature_body_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "Body",
        "confirm": {
          "preview_id": "$prev_body.structured_content.preview_id"
        }
      }
    },
    {
      "name": "prev_sketch",
      "mcp": "preview_dry_run",
      "args": {
        "doc": "$create.structured_content.doc",
        "operation": {
          "tool": "sketch_create",
          "args": {
            "name": "Sketch",
            "body": "Body",
            "plane": "XY"
          }
        }
      }
    },
    {
      "name": "sketch",
      "mcp": "sketch_create",
      "args": {
        "doc": "$create.structured_content.doc",
        "name": "Sketch",
        "body": "Body",
        "plane": "XY",
        "confirm": {
          "preview_id": "$prev_sketch.structured_content.preview_id"
        }
      }
    },
    {
      "name": "prev_geometry",
      "mcp": "preview_dry_run",
      "args": {
        "doc": "$create.structured_content.doc",
        "operation": {
          "tool": "sketch_add_geometry",
          "args": {
            "sketch": "Sketch",
            "geometry": [
              {
                "kind": "line_segment",
                "start": [
                  0,
                  0
                ],
                "end": [
                  20,
                  0
                ]
              },
              {
                "kind": "line_segment",
                "start": [
                  20,
                  0
                ],
                "end": [
                  20,
                  20
                ]
              },
              {
                "kind": "line_segment",
                "start": [
                  20,
                  20
                ],
                "end": [
                  0,
                  20
                ]
              },
              {
                "kind": "line_segment",
                "start": [
                  0,
                  20
                ],
                "end": [
                  0,
                  0
                ]
              }
            ],
            "constraints": [
              {
                "type": "Coincident",
                "first": 0,
                "first_pos": 2,
                "second": 1,
                "second_pos": 1
              },
              {
                "type": "Coincident",
                "first": 1,
                "first_pos": 2,
                "second": 2,
                "second_pos": 1
              },
              {
                "type": "Coincident",
                "first": 2,
                "first_pos": 2,
                "second": 3,
                "second_pos": 1
              },
              {
                "type": "Coincident",
                "first": 3,
                "first_pos": 2,
                "second": 0,
                "second_pos": 1
              },
              {
                "type": "Horizontal",
                "first": 0
              },
              {
                "type": "Horizontal",
                "first": 2
              },
              {
                "type": "Vertical",
                "first": 1
              },
              {
                "type": "Vertical",
                "first": 3
              },
              {
                "type": "Coincident",
                "first": 0,
                "first_pos": 1,
                "second": -1,
                "second_pos": 1
              },
              {
                "type": "DistanceX",
                "first": 0,
                "first_pos": 1,
                "second": 0,
                "second_pos": 2,
                "value": {
                  "value": 20,
                  "unit": "mm"
                }
              },
              {
                "type": "DistanceY",
                "first": 1,
                "first_pos": 1,
                "second": 1,
                "second_pos": 2,
                "value": {
                  "value": 20,
                  "unit": "mm"
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "geometry",
      "mcp": "sketch_add_geometry",
      "args": {
        "doc": "$create.structured_content.doc",
        "sketch": "Sketch",
        "geometry": [
          {
            "kind": "line_segment",
            "start": [
              0,
              0
            ],
            "end": [
              20,
              0
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              20,
              0
            ],
            "end": [
              20,
              20
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              20,
              20
            ],
            "end": [
              0,
              20
            ]
          },
          {
            "kind": "line_segment",
            "start": [
              0,
              20
            ],
            "end": [
              0,
              0
            ]
          }
        ],
        "constraints": [
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 2,
            "second": 1,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 1,
            "first_pos": 2,
            "second": 2,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 2,
            "first_pos": 2,
            "second": 3,
            "second_pos": 1
          },
          {
            "type": "Coincident",
            "first": 3,
            "first_pos": 2,
            "second": 0,
            "second_pos": 1
          },
          {
            "type": "Horizontal",
            "first": 0
          },
          {
            "type": "Horizontal",
            "first": 2
          },
          {
            "type": "Vertical",
            "first": 1
          },
          {
            "type": "Vertical",
            "first": 3
          },
          {
            "type": "Coincident",
            "first": 0,
            "first_pos": 1,
            "second": -1,
            "second_pos": 1
          },
          {
            "type": "DistanceX",
            "first": 0,
            "first_pos": 1,
            "second": 0,
            "second_pos": 2,
            "value": {
              "value": 20,
              "unit": "mm"
            }
          },
          {
            "type": "DistanceY",
            "first": 1,
            "first_pos": 1,
            "second": 1,
            "second_pos": 2,
            "value": {
              "value": 20,
              "unit": "mm"
            }
          }
        ],
        "confirm": {
          "preview_id": "$prev_geometry.structured_content.preview_id"
        }
      }
    },
    {
      "name": "prev_pad",
      "mcp": "preview_dry_run",
      "args": {
        "doc": "$create.structured_content.doc",
        "operation": {
          "tool": "feature_pad",
          "args": {
            "body": "Body",
            "profile": "Sketch",
            "name": "Pad",
            "length": {
              "value": 30,
              "unit": "mm"
            }
          }
        }
      }
    },
    {
      "name": "pad",
      "mcp": "feature_pad",
      "args": {
        "doc": "$create.structured_content.doc",
        "body": "Body",
        "profile": "Sketch",
        "name": "Pad",
        "length": {
          "value": 30,
          "unit": "mm"
        },
        "confirm": {
          "preview_id": "$prev_pad.structured_content.preview_id"
        }
      }
    },
    {
      "name": "mass_given",
      "mcp": "query_mass_properties",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "Pad"
      }
    },
    {
      "name": "fit_before",
      "mcp": "view_fit_viewport",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    },
    {
      "name": "preview",
      "mcp": "preview_dry_run",
      "args": {
        "doc": "$create.structured_content.doc",
        "operation": {
          "tool": "feature_fillet",
          "args": {
            "body": "Body",
            "base": "Pad",
            "name": "Fillet",
            "edges": [
              {
                "kind": "mapped_name",
                "object": "Pad",
                "mapped_name": "Edge1"
              }
            ],
            "radius": {
              "value": 500,
              "unit": "mm"
            }
          }
        }
      }
    },
    {
      "name": "mass",
      "mcp": "query_mass_properties",
      "args": {
        "doc": "$create.structured_content.doc",
        "object": "Pad"
      }
    },
    {
      "name": "fit",
      "mcp": "view_fit_viewport",
      "args": {
        "doc": "$create.structured_content.doc"
      }
    }
  ],
  "expect": [
    {
      "step": "body",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "sketch",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "geometry",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "pad",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "mass_given",
      "path": "structured_content.volume.value",
      "approx": 12000.0,
      "tolerance": 12.0
    },
    {
      "step": "fit_before",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "preview",
      "path": "status",
      "equals": "OK"
    },
    {
      "step": "preview",
      "path": "detail",
      "equals": null
    },
    {
      "step": "preview",
      "path": "structured_content.diff.validity.is_valid",
      "equals": false
    },
    {
      "step": "preview",
      "path": "structured_content.diff.validity.status",
      "regex": "^(SPEC_FAILED|RECOMPUTE_ERROR)$"
    },
    {
      "step": "preview",
      "path": "structured_content.diff.validity.explanation",
      "regex": "\\S"
    },
    {
      "step": "preview",
      "path": "structured_content.diff.validity.explanation",
      "regex": "\bFillet\b"
    },
    {
      "step": "preview",
      "path": "structured_content.diff.deltas.volume.before",
      "absent": false
    },
    {
      "step": "preview",
      "path": "structured_content.diff.deltas.volume.after",
      "absent": false
    },
    {
      "step": "preview",
      "path": "structured_content.diff.deltas.volume.delta",
      "absent": false
    },
    {
      "step": "preview",
      "path": "structured_content.diff.deltas.volume.units",
      "absent": false
    },
    {
      "step": "preview",
      "path": "structured_content.diff.new",
      "equals": []
    },
    {
      "step": "preview",
      "path": "structured_content.preview_id",
      "regex": "\\S"
    },
    {
      "step": "mass",
      "path": "structured_content.volume.value",
      "approx": 12000.0,
      "tolerance": 12.0
    },
    {
      "step": "fit",
      "path": "status",
      "equals": "OK"
    }
  ],
  "probe": {
    "tolerance": 0.01,
    "active_document": "TC0804",
    "documents": {
      "TC0804": {
        "objects": {
          "Pad": {
            "visibility": true,
            "valid": true,
            "volume": 12000
          }
        }
      }
    },
    "view": {
      "clipped": false
    }
  },
  "cross": [
    {
      "mcp": "mass.structured_content.volume.value",
      "probe": "documents.TC0804.objects.Pad.shape.volume",
      "tolerance": 0.01
    }
  ],
  "pixel": {
    "samples": [
      "TC0804.Pad"
    ],
    "extent": {
      "min_fraction": 0.5,
      "inside": true
    }
  },
  "agent_check": "The runner takes no before capture: capture the framed pad before the preview and compare it with the runner's capture; the two must be identical by eye, sharp edges, no rounded edge, no error-state colouring."
}
