{"tool": "script_exec", "args": {"doc": "fcb-doc:lhPDAFdJXyZ5a1EibTKc5g", "code": "import Part, Sketcher, FreeCAD as App\nV = App.Vector\nbody = doc.addObject('PartDesign::Body', 'Body')\nsk = body.newObject('Sketcher::SketchObject', 'Profile')\nsk.AttachmentSupport = [(body.Origin.OriginFeatures[3], '')]\nsk.MapMode = 'FlatFace'\nfor i, (a, b) in enumerate([((0,0),(8,0)), ((8,0),(8,16)), ((8,16),(0,16)), ((0,16),(0,0))]):\n    sk.addGeometry(Part.LineSegment(V(a[0], a[1], 0), V(b[0], b[1], 0)))\nfor i in range(4):\n    sk.addConstraint(Sketcher.Constraint('Coincident', i, 2, (i + 1) % 4, 1))\nfor i in (0, 2):\n    sk.addConstraint(Sketcher.Constraint('Horizontal', i))\nfor i in (1, 3):\n    sk.addConstraint(Sketcher.Constraint('Vertical', i))\nsk.addConstraint(Sketcher.Constraint('DistanceX', -1, 1, 0, 1, 0))\nsk.addConstraint(Sketcher.Constraint('DistanceY', -1, 1, 0, 1, 0))\nsk.addConstraint(Sketcher.Constraint('DistanceX', 0, 1, 0, 2, 8))\nsk.addConstraint(Sketcher.Constraint('DistanceY', 1, 1, 1, 2, 16))\ndoc.recompute()\npad = body.newObject('PartDesign::Pad', 'Block')\npad.Profile = sk\npad.Length = 5\ndoc.recompute()\nresult = ('built', sk.FullyConstrained)"}, "seconds": 0.05, "isError": false, "structuredContent": {"schema": "fcb.result-envelope/1", "status": "OK", "detail": null, "structured_content": {"doc": "fcb-doc:lhPDAFdJXyZ5a1EibTKc5g", "stdout": "", "value_repr": "('built', True)", "fingerprint_before": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f111
