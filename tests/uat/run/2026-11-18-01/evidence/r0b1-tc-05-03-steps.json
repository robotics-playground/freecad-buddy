   "code": "import Part, Sketcher\nfrom FreeCAD import Vector as V\nbody = doc.addObject('PartDesign::Body', 'Body')\nxy = [f for f in body.Origin.OriginFeatures if f.Role == 'XY_Plane'][0]\nsk = body.newObject('Sketcher::SketchObject', 'Sketch')\nsk.AttachmentSupport = [(xy, '')]\nsk.MapMode = 'FlatFace'\npts = [V(0, 0, 0), V(20, 0, 0), V(20, 20, 0), V(0, 20, 0)]\nfor i in range(4):\n    sk.addGeometry(Part.LineSegment(pts[i], pts[(i + 1) % 4]))\nfor i in range(4):\n    sk.addConstraint(Sketcher.Constraint('Coincident', i, 2, (i + 1) % 4, 1))\nfor i, kind in enumerate(['Horizontal', 'Vertical', 'Horizontal', 'Vertical']):\n    sk.addConstraint(Sketcher.Constraint(kind, i))\ndoc.recompute()\nresult = sk.solve()"
  },
