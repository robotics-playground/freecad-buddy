{
  "$defs": {
    "Check": {
      "properties": {
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "measured": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "measured_kind": {
          "anyOf": [
            {
              "enum": [
                "rate",
                "quantity",
                "count",
                "flag",
                "text"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "passed"
      ],
      "type": "object"
    },
    "ErrorDetail": {
      "properties": {
        "code": {
          "type": "string"
        },
        "constraint_ids": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "data": {
          "type": "object"
        },
        "message": {
          "type": "string"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "ReportBanner": {
      "properties": {
        "element_map_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "freecad_version": {
          "type": "string"
        },
        "validator_sensitivity": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "varset_backend": {
          "anyOf": [
            {
              "enum": [
                "varset",
                "spreadsheet"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "wilson_ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/WilsonCI"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "freecad_version",
        "element_map_version"
      ],
      "type": "object"
    },
    "WilsonCI": {
      "properties": {
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "n": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        },
        "rate": {
          "type": "number"
        }
      },
      "required": [
        "rate",
        "low",
        "high",
        "n",
        "r"
      ],
      "type": "object"
    }
  },
  "$id": "fcb.validation-report/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "if": {
    "anyOf": [
      {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "measured_kind": {
                  "const": "rate"
                }
              },
              "required": [
                "measured_kind"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "checks"
        ]
      },
      {
        "properties": {
          "warnings": {
            "contains": {
              "properties": {
                "measured_kind": {
                  "const": "rate"
                }
              },
              "required": [
                "measured_kind"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "warnings"
        ]
      }
    ]
  },
  "properties": {
    "banner": {
      "$ref": "#/$defs/ReportBanner"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "type": "array"
    },
    "schema": {
      "const": "fcb.validation-report/1"
    },
    "subject": {
      "type": "object"
    },
    "verdict": {
      "enum": [
        "OK",
        "SPEC_FAILED",
        "RECOMPUTE_ERROR",
        "TIMEOUT",
        "OOM_KILLED",
        "WORKER_CRASHED",
        "INVALID_INPUT"
      ]
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "banner",
    "checks",
    "verdict"
  ],
  "then": {
    "properties": {
      "banner": {
        "properties": {
          "wilson_ci": {
            "$ref": "#/$defs/WilsonCI"
          }
        },
        "required": [
          "wilson_ci"
        ],
        "type": "object"
      }
    },
    "required": [
      "banner"
    ]
  },
  "title": "ValidationReport",
  "type": "object"
}
