          },
          "type": "array"
        },
        "data": {
          "type": "object"
        },
        "message": {
          "type": "string"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "ReportBanner": {
      "properties": {
        "element_map_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "freecad_version": {
          "type": "string"
        },
        "validator_sensitivity": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "wilson_ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/WilsonCI"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "freecad_version",
        "element_map_version"
      ],
      "type": "object"
    },
    "WilsonCI": {
      "properties": {
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "n": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        },
        "rate": {
          "type": "number"
        }
      },
      "type": "object"
    }
