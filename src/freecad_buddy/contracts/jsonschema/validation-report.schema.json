  "$id": "fcb.validation-report/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "banner": {
      "$ref": "#/$defs/ReportBanner"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "type": "array"
    },
    "schema": {
      "const": "fcb.validation-report/1"
    },
    "subject": {
      "type": "object"
    },
    "verdict": {
      "enum": [
        "OK",
        "SPEC_FAILED",
        "RECOMPUTE_ERROR",
        "TIMEOUT",
        "OOM_KILLED",
        "WORKER_CRASHED",
        "INVALID_INPUT"
      ]
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "banner",
    "checks",
    "verdict"
  ],
  "title": "ValidationReport",
  "type": "object"
}
